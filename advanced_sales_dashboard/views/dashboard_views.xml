<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action — OWL Dashboard App -->
    <record id="action_advanced_sales_dashboard" model="ir.actions.client">
        <field name="name">Advanced Sales Dashboard</field>
        <field name="tag">advanced_sales_dashboard.action_dashboard</field>
        <field name="target">main</field>
    </record>

    <!-- Manage Dashboards action (re-export for menus) -->
    <record id="action_manage_dashboards" model="ir.actions.act_window">
        <field name="name">Manage Dashboards</field>
        <field name="res_model">dashboard.board</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── Sales Menu ─────────────────────────────────────────── -->
    <menuitem id="menu_advanced_sales_dashboard"
              name="Dashboard"
              parent="sale.sale_menu_root"
              action="action_advanced_sales_dashboard"
              sequence="1"
              groups="advanced_sales_dashboard.group_dashboard_user"/>

    <menuitem id="menu_manage_dashboards"
              name="Manage Dashboards"
              parent="sale.sale_menu_root"
              action="action_manage_dashboards"
              sequence="99"
              groups="advanced_sales_dashboard.group_dashboard_manager"/>

</odoo>
