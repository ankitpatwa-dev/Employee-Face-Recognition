<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================
         Dashboard Board — Backend List & Form Views
         ====================================================== -->

    <record id="view_dashboard_board_list" model="ir.ui.view">
        <field name="name">dashboard.board.list</field>
        <field name="model">dashboard.board</field>
        <field name="arch" type="xml">
            <list string="Dashboards" decoration-muted="not active">
                <field name="name"/>
                <field name="theme"/>
                <field name="user_id"/>
                <field name="item_count"/>
                <field name="is_predefined"/>
                <field name="is_favorite"/>
                <field name="auto_refresh"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_dashboard_board_form" model="ir.ui.view">
        <field name="name">dashboard.board.form</field>
        <field name="model">dashboard.board</field>
        <field name="arch" type="xml">
            <form string="Dashboard Board">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_dashboard" type="object"
                                class="oe_stat_button" icon="fa-dashboard">
                            <span>Open Dashboard</span>
                        </button>
                        <button name="action_duplicate" type="object"
                                class="oe_stat_button" icon="fa-copy">
                            <span>Duplicate</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Predefined"
                            bg_color="bg-info"
                            invisible="not is_predefined"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Dashboard Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_predefined" groups="advanced_sales_dashboard.group_dashboard_admin"/>
                            <field name="is_favorite"/>
                        </group>
                        <group>
                            <field name="theme"/>
                            <field name="layout_cols"/>
                            <field name="auto_refresh"/>
                            <field name="refresh_interval"
                                   invisible="not auto_refresh"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sharing">
                            <field name="shared_user_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Items">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="item_type"/>
                                    <field name="model_name"/>
                                    <field name="color_theme"/>
                                    <field name="grid_w"/>
                                    <field name="grid_h"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================================================
         Dashboard Board — Actions & Menus
         ====================================================== -->

    <record id="action_dashboard_boards" model="ir.actions.act_window">
        <field name="name">Manage Dashboards</field>
        <field name="res_model">dashboard.board</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_boards': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first dashboard!</p>
        </field>
    </record>

    <!-- ======================================================
         Dashboard Item — Form View (for detailed editing)
         ====================================================== -->

    <record id="view_dashboard_item_form" model="ir.ui.view">
        <field name="name">dashboard.item.form</field>
        <field name="model">dashboard.item</field>
        <field name="arch" type="xml">
            <form string="Dashboard Item">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Tile Title"/></h1>
                    </div>
                    <group>
                        <group string="Type &amp; Source">
                            <field name="item_type"/>
                            <field name="model_name"
                                   invisible="item_type in ['todo','note']"/>
                            <field name="domain"
                                   invisible="item_type in ['todo','note']"/>
                            <field name="filter_date_field"
                                   invisible="item_type in ['todo','note']"/>
                        </group>
                        <group string="Date Filter">
                            <field name="date_filter"
                                   invisible="item_type in ['todo','note']"/>
                            <field name="date_start"
                                   invisible="date_filter != 'custom'"/>
                            <field name="date_end"
                                   invisible="date_filter != 'custom'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Aggregation"
                               invisible="item_type in ['todo','note']">
                            <field name="measure_field"/>
                            <field name="measure_operator"/>
                            <field name="group_by_field"
                                   invisible="item_type != 'chart'"/>
                            <field name="sort_by"/>
                            <field name="sort_order"/>
                            <field name="record_limit"/>
                            <field name="compare_period"
                                   invisible="item_type not in ['kpi','gauge']"/>
                        </group>
                        <group string="Chart Settings"
                               invisible="item_type != 'chart'">
                            <field name="chart_type"/>
                            <field name="chart_color_palette"/>
                            <field name="show_data_values"/>
                            <field name="show_legend"/>
                            <field name="fill_area"/>
                            <field name="smooth_line"/>
                        </group>
                    </group>
                    <group>
                        <group string="Display">
                            <field name="color_theme"/>
                            <field name="icon"/>
                            <field name="unit_type"/>
                            <field name="custom_unit"
                                   invisible="unit_type != 'custom'"/>
                            <field name="currency_id"
                                   invisible="unit_type != 'monetary'"/>
                            <field name="number_system"/>
                        </group>
                        <group string="Target"
                               invisible="item_type not in ['kpi','gauge']">
                            <field name="has_target"/>
                            <field name="target_value"
                                   invisible="not has_target"/>
                            <field name="target_label"
                                   invisible="not has_target"/>
                        </group>
                    </group>
                    <group string="Grid Layout">
                        <group>
                            <field name="grid_x"/>
                            <field name="grid_y"/>
                        </group>
                        <group>
                            <field name="grid_w"/>
                            <field name="grid_h"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
