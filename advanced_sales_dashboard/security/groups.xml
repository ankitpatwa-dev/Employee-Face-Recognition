<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- =========================================================
             Dashboard Access Groups
             ========================================================= -->

        <!-- Category (shown in user settings) -->
        <record id="module_category_dashboard" model="ir.module.category">
            <field name="name">Advanced Dashboard</field>
            <field name="description">Manage access to Advanced Sales Dashboard</field>
            <field name="sequence">100</field>
        </record>

        <!-- Dashboard User: can VIEW all dashboards they have access to -->
        <record id="group_dashboard_user" model="res.groups">
            <field name="name">Dashboard User</field>
            <field name="category_id" ref="module_category_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view dashboards. Cannot create or modify.</field>
        </record>

        <!-- Dashboard Manager: can create, edit, delete and share dashboards -->
        <record id="group_dashboard_manager" model="res.groups">
            <field name="name">Dashboard Manager</field>
            <field name="category_id" ref="module_category_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('group_dashboard_user'))]"/>
            <field name="comment">Can create and manage dashboards and tiles.</field>
        </record>

        <!-- Dashboard Admin: full access including AI settings, predefined dashboards -->
        <record id="group_dashboard_admin" model="res.groups">
            <field name="name">Dashboard Administrator</field>
            <field name="category_id" ref="module_category_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('group_dashboard_manager'))]"/>
            <field name="comment">Full dashboard access including AI API configuration and predefined dashboard management.</field>
        </record>

    </data>
</odoo>
